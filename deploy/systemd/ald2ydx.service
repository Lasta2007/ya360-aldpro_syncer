[Unit]
Description=Синхронизация каталога ALD Pro -> Яндекс 360 (ya360-aldpro_syncer)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ald2ydx
Group=ald2ydx
# Весь проект — в одном каталоге /opt/ya360-aldpro_syncer
# (код, venv, конфиг config/config.yaml, секреты secret.env, состояние state/, логи logs/)
WorkingDirectory=/opt/ya360-aldpro_syncer
Environment=A2Y_CONFIG=/opt/ya360-aldpro_syncer/config/config.yaml
# Секреты — в файле с правами 600 внутри дерева проекта:
EnvironmentFile=-/opt/ya360-aldpro_syncer/secret.env
ExecStart=/opt/ya360-aldpro_syncer/venv/bin/python -m ald2ydx --config /opt/ya360-aldpro_syncer/config/config.yaml
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ya360-aldpro_syncer/state /opt/ya360-aldpro_syncer/logs
Restart=no

[Install]
WantedBy=multi-user.target
